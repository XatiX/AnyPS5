set(ANYPS5_GPU_BACKEND "anyps5" CACHE STRING "GPU backend: anyps5 (the libSceAgcDriver execution layer) or unified (the recode core)")
set_property(CACHE ANYPS5_GPU_BACKEND PROPERTY STRINGS anyps5 unified)
if(NOT ANYPS5_GPU_BACKEND MATCHES "^(anyps5|unified)$")
    message(FATAL_ERROR "ANYPS5_GPU_BACKEND must be anyps5 or unified, not '${ANYPS5_GPU_BACKEND}'")
endif()
if(ANYPS5_GPU_BACKEND STREQUAL "unified" AND CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
    function(anyps5_unified_route_off_tests directory)
        get_property(routeTests DIRECTORY "${directory}" PROPERTY TESTS)
        foreach(routeTest IN LISTS routeTests)
            get_property(routeTestEnvironment TEST ${routeTest} DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
            if(routeTest MATCHES "recode|unified" OR "${routeTestEnvironment}" MATCHES "APS5_RECODE_")
                continue()
            endif()
            set_property(TEST ${routeTest} DIRECTORY "${directory}" APPEND PROPERTY ENVIRONMENT "APS5_RECODE_ROUTE=0")
        endforeach()
        get_property(routeChildren DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        foreach(routeChild IN LISTS routeChildren)
            anyps5_unified_route_off_tests("${routeChild}")
        endforeach()
    endfunction()
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL anyps5_unified_route_off_tests "${CMAKE_SOURCE_DIR}")
endif()
