set(ANYPS5_GPU_BACKEND "anyps5" CACHE STRING "GPU backend: anyps5 (the libSceAgcDriver execution layer) or unified (the recode core, RECODE.md)")
set_property(CACHE ANYPS5_GPU_BACKEND PROPERTY STRINGS anyps5 unified)
if(NOT ANYPS5_GPU_BACKEND MATCHES "^(anyps5|unified)$")
    message(FATAL_ERROR "ANYPS5_GPU_BACKEND must be anyps5 or unified, not '${ANYPS5_GPU_BACKEND}'")
endif()
if(ANYPS5_GPU_BACKEND STREQUAL "unified")
    add_compile_definitions(ANYPS5_UNIFIED=1)
endif()
